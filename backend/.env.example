# App
APP_NAME=AI Interview Coach
DEBUG=true
DATABASE_URL=sqlite:///./interview_coach.db

# CORS (comma-separated origins for Vercel + local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider: groq | openai | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Provider API keys (set the one matching LLM_PROVIDER)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: faster-whisper (local transcription)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
